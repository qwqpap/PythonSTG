{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonstg.dev/schemas/pystg-scene-v3.schema.json",
  "title": "PySTG Scene Document v3",
  "type": "object",
  "required": ["schema_version", "type", "id", "name", "metadata", "root", "state_graph"],
  "properties": {
    "schema_version": {"const": 3},
    "type": {"const": "pystg.scene"},
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "symbol_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "metadata": {"type": "object"},
    "root": {"$ref": "#/$defs/node"},
    "state_graph": {"$ref": "#/$defs/state_graph"}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "properties", "children"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "properties": {"type": "object"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        }
      },
      "additionalProperties": false
    },
    "state_graph": {
      "type": "object",
      "required": ["id", "name", "initial_state_id", "states"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "initial_state_id": {"type": "string", "format": "uuid"},
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/state"}
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "id",
        "name",
        "order",
        "duration_frames",
        "entry_actions",
        "exit_actions",
        "tracks",
        "transitions",
        "child_graph"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 0},
        "entry_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/state_action"}
        },
        "exit_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/state_action"}
        },
        "tracks": {
          "type": "array",
          "items": {"$ref": "#/$defs/track"}
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition"}
        },
        "child_graph": {
          "oneOf": [
            {"$ref": "#/$defs/state_graph"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "state_action": {
      "type": "object",
      "required": ["id", "name", "kind", "target_id", "channel", "order", "payload"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Audio", "Event", "ScriptEvent"]},
        "target_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "name", "target_state_id", "trigger", "after_frames", "priority"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "target_state_id": {"type": "string", "format": "uuid"},
        "trigger": {"enum": ["after", "complete"]},
        "after_frames": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "priority": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"trigger": {"const": "after"}}},
          "then": {"properties": {"after_frames": {"type": "integer", "minimum": 1}}},
          "else": {"properties": {"after_frames": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "kind", "target_id", "channel", "order", "muted", "clips"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Pattern", "Movement", "Audio", "Event", "Property", "ScriptEvent"]},
        "target_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "muted": {"type": "boolean"},
        "clips": {
          "type": "array",
          "items": {"$ref": "#/$defs/clip"}
        }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "start_frame",
        "duration_frames",
        "target_id",
        "channel",
        "order",
        "loop_count",
        "enabled",
        "payload",
        "keyframes"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Pattern", "Movement", "Audio", "Event", "Property", "ScriptEvent"]},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "target_id": {
          "oneOf": [
            {"type": "string", "format": "uuid"},
            {"type": "null"}
          ]
        },
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "loop_count": {"type": "integer", "minimum": 1},
        "enabled": {"type": "boolean"},
        "payload": {"type": "object"},
        "keyframes": {
          "type": "array",
          "items": {"$ref": "#/$defs/keyframe"}
        }
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "frame", "value", "interpolation"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "frame": {"type": "integer", "minimum": 0},
        "value": {},
        "interpolation": {"enum": ["step", "linear", "ease_in", "ease_out", "ease_in_out"]}
      },
      "additionalProperties": false
    }
  }
}
