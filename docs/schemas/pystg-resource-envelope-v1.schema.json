{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonstg.dev/schemas/pystg-resource-envelope-v1.schema.json",
  "title": "PySTG Authoring Resource Envelope",
  "description": "Common versioned header. Domain schemas add their own fields.",
  "type": "object",
  "required": ["schema_version", "type", "id", "name"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {
      "enum": [
        "pystg.scene",
        "pystg.pattern",
        "pystg.ui",
        "pystg.background"
      ]
    },
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "symbol_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
