{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonstg.dev/schemas/pystg-scene-v1.schema.json",
  "title": "PySTG Scene Document",
  "type": "object",
  "required": ["schema_version", "type", "id", "name", "root", "timeline"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "pystg.scene"},
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "root": {"$ref": "#/$defs/node"},
    "timeline": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "properties", "children"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "properties": {"type": "object"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "frame", "type", "properties"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "frame": {"type": "integer", "minimum": 0},
        "type": {"type": "string", "minLength": 1},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
