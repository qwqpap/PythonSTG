{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonstg.dev/schemas/pystg-scene-v4.schema.json",
  "title": "PySTG Scene Document v4",
  "type": "object",
  "required": ["schema_version", "type", "id", "name", "metadata", "root", "state_graph", "variables", "output_mappings"],
  "properties": {
    "schema_version": {"const": 4},
    "type": {"const": "pystg.scene"},
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "symbol_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "metadata": {"type": "object"},
    "root": {"$ref": "#/$defs/node"},
    "state_graph": {"$ref": "#/$defs/state_graph"},
    "variables": {"type": "array", "items": {"$ref": "#/$defs/variable"}},
    "output_mappings": {"type": "array", "items": {"$ref": "#/$defs/output_mapping"}}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "properties", "children"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "properties": {"type": "object"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      },
      "additionalProperties": false
    },
    "variable_ref": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "scope": {"enum": ["project", "stage", "state", "clip", "reaction", "behavior", "engine_snapshot"]},
        "type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["id", "name", "type", "default", "scope", "writable_by", "readers", "animatable", "record_in_replay", "debug_display", "reducer", "behavior_output"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "type": {"enum": ["bool", "int", "float", "string", "vector2", "color", "resource", "complex"]},
        "default": {},
        "scope": {"enum": ["project", "stage", "state", "clip", "reaction", "behavior", "engine_snapshot"]},
        "writable_by": {"type": "array", "items": {"enum": ["timeline", "safe_action", "behavior", "engine_snapshot"]}, "uniqueItems": true},
        "readers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "animatable": {"type": "boolean"},
        "record_in_replay": {"type": "boolean"},
        "debug_display": {"type": "string", "minLength": 1},
        "reducer": {"enum": ["override", "add", "multiply", "blend", null]},
        "behavior_output": {"type": "boolean"},
        "owner_id": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    },
    "output_mapping": {
      "type": "object",
      "required": ["id", "source", "target", "operation"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "source": {"$ref": "#/$defs/variable_ref"},
        "target": {"$ref": "#/$defs/variable_ref"},
        "operation": {"enum": ["set", "add", "toggle", "reset"]}
      },
      "additionalProperties": false
    },
    "state_graph": {
      "type": "object",
      "required": ["id", "name", "initial_state_id", "states"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "initial_state_id": {"type": "string", "format": "uuid"},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "name", "order", "duration_frames", "entry_actions", "exit_actions", "tracks", "transitions", "child_graph", "variables", "output_mappings"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 0},
        "entry_actions": {"type": "array", "items": {"$ref": "#/$defs/state_action"}},
        "exit_actions": {"type": "array", "items": {"$ref": "#/$defs/state_action"}},
        "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "child_graph": {"anyOf": [{"$ref": "#/$defs/state_graph"}, {"type": "null"}]},
        "variables": {"type": "array", "items": {"$ref": "#/$defs/variable"}},
        "output_mappings": {"type": "array", "items": {"$ref": "#/$defs/output_mapping"}}
      },
      "additionalProperties": false
    },
    "state_action": {
      "type": "object",
      "required": ["id", "name", "kind", "target_id", "channel", "order", "payload"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Audio", "Event", "ScriptEvent", "Variable"]},
        "target_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "name", "target_state_id", "trigger", "after_frames", "priority"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "target_state_id": {"type": "string", "format": "uuid"},
        "trigger": {"enum": ["after", "complete"]},
        "after_frames": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "priority": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "kind", "target_id", "channel", "order", "muted", "clips"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Pattern", "Movement", "Audio", "Event", "Property", "ScriptEvent", "Variable"]},
        "target_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "muted": {"type": "boolean"},
        "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}}
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "required": ["id", "name", "kind", "start_frame", "duration_frames", "target_id", "channel", "order", "loop_count", "enabled", "payload", "keyframes"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Pattern", "Movement", "Audio", "Event", "Property", "ScriptEvent", "Variable"]},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "target_id": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
        "channel": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "loop_count": {"type": "integer", "minimum": 1},
        "enabled": {"type": "boolean"},
        "payload": {"type": "object"},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}}
      },
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "required": ["id", "frame", "value", "interpolation"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "frame": {"type": "integer", "minimum": 0},
        "value": {},
        "interpolation": {"enum": ["step", "linear", "ease_in", "ease_out", "ease_in_out"]}
      },
      "additionalProperties": false
    }
  }
}
